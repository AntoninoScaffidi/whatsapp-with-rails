<div class="max-w-xl mx-auto mt-16 px-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Contacts</h1>
    <%= link_to "Add contact", new_contact_path,
        class: "bg-emerald-600 text-white px-4 py-2 rounded-md hover:bg-emerald-700" %>
  </div>

  <% if notice %>
    <p class="mb-4 text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-md px-3 py-2">
      <%= notice %>
    </p>
  <% end %>

  <% if @contacts.empty? %>
    <p class="text-gray-500">No contacts yet.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 border border-gray-200 rounded-md">
      <% @contacts.each do |contact| %>
        <li class="flex items-center justify-between px-4 py-3">
          <span><%= contact.name %></span>
          <span class="text-gray-500 text-sm"><%= contact.whatsapp_number %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
