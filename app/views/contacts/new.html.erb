<div class="max-w-xl mx-auto mt-16 px-4">
  <h1 class="text-2xl font-semibold mb-6">Add contact</h1>

  <%= form_with model: @contact, class: "flex flex-col gap-4" do |f| %>
    <% if @contact.errors.any? %>
      <div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-md px-3 py-2">
        <ul class="list-disc list-inside">
          <% @contact.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name,
          class: "w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= f.label :whatsapp_number, "WhatsApp number", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :whatsapp_number, placeholder: "+391234567890",
          class: "w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
      <p class="text-xs text-gray-500 mt-1">E.164 format: country code, no spaces or dashes.</p>
    </div>

    <%= f.submit "Add contact",
        class: "self-start bg-emerald-600 text-white px-4 py-2 rounded-md hover:bg-emerald-700 cursor-pointer" %>
  <% end %>
</div>
